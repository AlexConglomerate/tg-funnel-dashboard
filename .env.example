# Токен от @BotFather
BOT_TOKEN=123456:ABC-replace-me
# Telegram ID через запятую: видят дашборд и получают алерты (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111

# HTTPS-адрес Mini App. Обычно не задаётся вручную: его подставляет ./scripts/dev.sh
# WEBAPP_URL=

# Если api.telegram.org недоступен из сети напрямую:
# либо готовый прокси для Bot API,
# PROXY_URL=socks5://127.0.0.1:1080
# либо сервер с доступом к Telegram: dev.sh сам поднимет ssh -D и выставит PROXY_URL
# PROXY_SSH=user@host

# HTTP_PORT=8080
# DB_PATH=data/funnel.db
# FUNNEL_CONFIG=config/funnel.yaml
# LOG_LEVEL=INFO
